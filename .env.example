# Owner connection: runs migrations.
DATABASE_URL=postgres://crop:crop@localhost:5432/crop
# App connection: a role without BYPASSRLS, created by the first migration.
APP_DATABASE_URL=postgres://crop_app:crop_app@localhost:5432/crop
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Sign-in (Zitadel). Leave blank to run without sign-in: every protected route then returns 401.
AUTH_ISSUER=
AUTH_AUDIENCE=
# Web sign-in (apps/web)
AUTH_CLIENT_ID=
AUTH_PROJECT_ID=
APP_URL=http://localhost:3000
SESSION_SECRET=
# Credential documents. Local development can use DOCUMENT_STORE=memory instead (files lost on restart).
DOCUMENT_STORE=memory
SPACES_BUCKET=
SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=
