{
  "name": "crop",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/web dev",
    "build": "pnpm -r --filter=!@crop/mobile build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @crop/db migrate"
  }
}
